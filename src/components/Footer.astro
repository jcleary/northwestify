---
// No props needed
---

<footer class="site-footer">
  <div class="footer-inner container">
    <div class="footer-brand">
      <span class="footer-wordmark">NORTHWESTIFY</span>
      <p class="footer-tagline">Business conversations from the Northwest</p>
    </div>

    <nav class="footer-links" aria-label="Podcast platforms">
      <a
        href="#"
        class="footer-link"
        aria-label="Listen on Apple Podcasts"
        rel="noopener noreferrer"
      >
        <svg
          class="platform-icon"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          width="18"
          height="18"
        >
          <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 4.5a7.5 7.5 0 0 1 7.5 7.5 7.5 7.5 0 0 1-7.5 7.5A7.5 7.5 0 0 1 4.5 12 7.5 7.5 0 0 1 12 4.5zm0 1.5a6 6 0 0 0-6 6 6 6 0 0 0 6 6 6 6 0 0 0 6-6 6 6 0 0 0-6-6zm0 2.25a3.75 3.75 0 0 1 3.75 3.75 3.75 3.75 0 0 1-3.75 3.75A3.75 3.75 0 0 1 8.25 12 3.75 3.75 0 0 1 12 8.25zm0 1.5a2.25 2.25 0 0 0-2.25 2.25A2.25 2.25 0 0 0 12 14.25 2.25 2.25 0 0 0 14.25 12 2.25 2.25 0 0 0 12 9.75zm0 .75a1.5 1.5 0 0 1 1.5 1.5 1.5 1.5 0 0 1-1.5 1.5 1.5 1.5 0 0 1-1.5-1.5A1.5 1.5 0 0 1 12 10.5z"/>
        </svg>
        Apple Podcasts
      </a>

      <a
        href="#"
        class="footer-link"
        aria-label="Listen on Spotify"
        rel="noopener noreferrer"
      >
        <svg
          class="platform-icon"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          width="18"
          height="18"
        >
          <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
        </svg>
        Spotify
      </a>
    </nav>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p class="copyright">&copy; 2025 NorthWestify. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0d0d0d;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 2rem;
  }

  .footer-inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 2rem;
    flex-wrap: wrap;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-wordmark {
    font-family: 'Syne', system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.125rem;
    letter-spacing: 0.05em;
    color: #00d4c8;
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: #888888;
    line-height: 1.4;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: flex-end;
  }

  .footer-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #888888;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-link:hover {
    color: #00d4c8;
    opacity: 1;
  }

  .platform-icon {
    flex-shrink: 0;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1rem 0;
  }

  .copyright {
    font-size: 0.8125rem;
    color: #888888;
    line-height: 1.5;
  }

  @media (max-width: 480px) {
    .footer-inner {
      flex-direction: column;
    }

    .footer-links {
      align-items: flex-start;
    }
  }
</style>
