---
// No props needed
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-wordmark">NorthWestify</span>
      <p class="footer-tagline">Recorded in Ancoats · Listened to everywhere</p>
    </div>

    <div class="footer-right">
      <div class="footer-chips">
        <a href="https://podcasts.apple.com/ie/podcast/northwestify-podcast/id1483460602" class="chip-link" aria-label="Listen on Apple Podcasts" target="_blank" rel="noopener noreferrer">
          Apple Podcasts
        </a>
        <a href="https://open.spotify.com/show/2bMW8JJU1n5c08hL1oVfL4" class="chip-link" aria-label="Listen on Spotify" target="_blank" rel="noopener noreferrer">
          Spotify
        </a>
        <a href="#" class="chip-link" aria-label="RSS feed" rel="noopener noreferrer">
          RSS
        </a>
      </div>
      <span class="copyright">&copy; 2026 NorthWestify</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--nw-ink, #1a1a1a);
    padding: 48px 64px;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 24px;
  }

  /* Brand (left) */
  .footer-brand {
    display: flex;
    flex-direction: column;
  }

  .footer-wordmark {
    font-family: 'Unbounded', system-ui, sans-serif;
    font-weight: 800;
    font-size: 28px;
    color: var(--nw-cream-2, #fff4e8);
    line-height: 1;
  }

  .footer-tagline {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--nw-orange, #ff6b35);
    margin-top: 10px;
    line-height: 1;
  }

  /* Right side */
  .footer-right {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }

  .footer-chips {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;
  }

  .chip-link {
    background: transparent;
    border: 1.5px solid rgba(255, 251, 245, 0.2);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
    font-family: 'Inter Tight', 'Inter', system-ui, sans-serif;
    color: var(--nw-cream-2, #fff4e8);
    text-decoration: none;
    transition: opacity 150ms ease;
    white-space: nowrap;
  }

  .chip-link:hover {
    opacity: 0.7;
  }

  .copyright {
    font-size: 12px;
    color: rgba(255, 251, 245, 0.4);
    font-family: 'Inter Tight', 'Inter', system-ui, sans-serif;
    margin-left: 20px;
    white-space: nowrap;
  }

  /* Mobile */
  @media (max-width: 560px) {
    .site-footer {
      padding: 32px 24px;
    }

    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer-right {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .footer-chips {
      flex-wrap: wrap;
    }

    .copyright {
      margin-left: 0;
    }
  }
</style>
