---
interface Props {
  audioUrl: string;
  title: string;
}

const { audioUrl, title } = Astro.props;

// Unique ID for this player instance (handles multiple players on one page)
const playerId = `player-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="audio-player" id={playerId} data-audio-url={audioUrl}>
  <!-- Hidden native audio element for control -->
  <audio
    class="player-audio"
    preload="metadata"
    aria-label={`Audio player for: ${title}`}
  >
    <source src={audioUrl} type="audio/mpeg" />
    Your browser does not support the audio element.
  </audio>

  <!-- Play / Pause button -->
  <button class="play-btn" aria-label="Play" title="Play / Pause">
    <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" width="22" height="22" aria-hidden="true">
      <path d="M8 5v14l11-7z"/>
    </svg>
    <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" width="22" height="22" aria-hidden="true" style="display:none">
      <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
    </svg>
  </button>

  <!-- Time display -->
  <span class="time-current">0:00</span>

  <!-- Progress bar -->
  <div class="progress-track" role="slider" aria-label="Seek" tabindex="0" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <div class="progress-fill"></div>
    <div class="progress-thumb"></div>
  </div>

  <!-- Total duration -->
  <span class="time-total">--:--</span>

  <!-- Volume -->
  <button class="volume-btn" aria-label="Mute / Unmute" title="Mute">
    <svg class="icon-vol-on" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
      <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3A4.5 4.5 0 0 0 14 7.97v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
    </svg>
    <svg class="icon-vol-off" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true" style="display:none">
      <path d="M16.5 12A4.5 4.5 0 0 0 14 7.97v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
    </svg>
  </button>
</div>

<script>
  // Self-contained IIFE per player to avoid globals
  document.querySelectorAll<HTMLElement>('.audio-player').forEach((player) => {
    const audio = player.querySelector<HTMLAudioElement>('.player-audio')!;
    const playBtn = player.querySelector<HTMLButtonElement>('.play-btn')!;
    const iconPlay = player.querySelector<SVGElement>('.icon-play')!;
    const iconPause = player.querySelector<SVGElement>('.icon-pause')!;
    const timeCurrent = player.querySelector<HTMLElement>('.time-current')!;
    const timeTotal = player.querySelector<HTMLElement>('.time-total')!;
    const progressTrack = player.querySelector<HTMLElement>('.progress-track')!;
    const progressFill = player.querySelector<HTMLElement>('.progress-fill')!;
    const progressThumb = player.querySelector<HTMLElement>('.progress-thumb')!;
    const volumeBtn = player.querySelector<HTMLButtonElement>('.volume-btn')!;
    const iconVolOn = player.querySelector<SVGElement>('.icon-vol-on')!;
    const iconVolOff = player.querySelector<SVGElement>('.icon-vol-off')!;

    if (!audio) return;

    function formatTime(seconds: number): string {
      if (isNaN(seconds) || !isFinite(seconds)) return '--:--';
      const m = Math.floor(seconds / 60);
      const s = Math.floor(seconds % 60);
      return `${m}:${s.toString().padStart(2, '0')}`;
    }

    function setProgress(pct: number) {
      const clamped = Math.max(0, Math.min(100, pct));
      progressFill.style.width = `${clamped}%`;
      progressThumb.style.left = `${clamped}%`;
      progressTrack.setAttribute('aria-valuenow', String(Math.round(clamped)));
    }

    // Play / Pause
    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play();
      } else {
        audio.pause();
      }
    });

    audio.addEventListener('play', () => {
      iconPlay.style.display = 'none';
      iconPause.style.display = '';
      playBtn.setAttribute('aria-label', 'Pause');
      player.classList.add('is-playing');
    });

    audio.addEventListener('pause', () => {
      iconPlay.style.display = '';
      iconPause.style.display = 'none';
      playBtn.setAttribute('aria-label', 'Play');
      player.classList.remove('is-playing');
    });

    audio.addEventListener('ended', () => {
      iconPlay.style.display = '';
      iconPause.style.display = 'none';
      playBtn.setAttribute('aria-label', 'Play');
      player.classList.remove('is-playing');
      setProgress(0);
    });

    // Time updates
    audio.addEventListener('loadedmetadata', () => {
      timeTotal.textContent = formatTime(audio.duration);
    });

    audio.addEventListener('timeupdate', () => {
      timeCurrent.textContent = formatTime(audio.currentTime);
      if (audio.duration) {
        setProgress((audio.currentTime / audio.duration) * 100);
      }
    });

    // Progress scrubbing — click or drag
    function seekFromEvent(e: MouseEvent | TouchEvent) {
      const rect = progressTrack.getBoundingClientRect();
      const clientX = e instanceof MouseEvent ? e.clientX : e.touches[0].clientX;
      const pct = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
      if (audio.duration && isFinite(audio.duration)) {
        audio.currentTime = pct * audio.duration;
      }
    }

    let isScrubbing = false;
    progressTrack.addEventListener('mousedown', (e) => {
      isScrubbing = true;
      seekFromEvent(e);
    });
    progressTrack.addEventListener('touchstart', (e) => {
      isScrubbing = true;
      seekFromEvent(e);
    }, { passive: true });

    window.addEventListener('mousemove', (e) => {
      if (isScrubbing) seekFromEvent(e);
    });
    window.addEventListener('mouseup', () => { isScrubbing = false; });
    window.addEventListener('touchend', () => { isScrubbing = false; });

    // Keyboard seek on progress track
    progressTrack.addEventListener('keydown', (e) => {
      const step = 5; // seconds
      if (e.key === 'ArrowRight') {
        audio.currentTime = Math.min(audio.duration, audio.currentTime + step);
      } else if (e.key === 'ArrowLeft') {
        audio.currentTime = Math.max(0, audio.currentTime - step);
      }
    });

    // Volume / Mute toggle
    volumeBtn.addEventListener('click', () => {
      audio.muted = !audio.muted;
      iconVolOn.style.display = audio.muted ? 'none' : '';
      iconVolOff.style.display = audio.muted ? '' : 'none';
      volumeBtn.setAttribute('aria-label', audio.muted ? 'Unmute' : 'Mute');
    });
  });
</script>

<style>
  .audio-player {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 0.875rem 1.125rem;
    width: 100%;
  }

  .audio-player .player-audio {
    display: none;
  }

  /* Play / Pause button */
  .play-btn {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #00d4c8;
    border: none;
    cursor: pointer;
    color: #0d0d0d;
    transition: background 150ms ease, transform 150ms ease;
  }

  .play-btn:hover {
    background: #00bfb5;
    transform: scale(1.06);
  }

  .play-btn:active {
    transform: scale(0.96);
  }

  .play-btn:focus-visible {
    outline: 2px solid #00d4c8;
    outline-offset: 3px;
  }

  /* Time */
  .time-current,
  .time-total {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: #888888;
    flex-shrink: 0;
    min-width: 3ch;
    white-space: nowrap;
  }

  /* Progress track */
  .progress-track {
    position: relative;
    flex: 1;
    height: 4px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 2px;
    cursor: pointer;
    transition: height 150ms ease;
  }

  .progress-track:hover,
  .audio-player.is-playing .progress-track {
    height: 6px;
  }

  .progress-fill {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 0%;
    background: #00d4c8;
    border-radius: 2px;
    pointer-events: none;
    transition: width 100ms linear;
  }

  .progress-thumb {
    position: absolute;
    top: 50%;
    left: 0%;
    transform: translate(-50%, -50%);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #00d4c8;
    pointer-events: none;
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .progress-track:hover .progress-thumb {
    opacity: 1;
  }

  /* Volume */
  .volume-btn {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    color: #888888;
    border-radius: 4px;
    transition: color 150ms ease;
  }

  .volume-btn:hover {
    color: #ffffff;
  }

  .volume-btn:focus-visible {
    outline: 2px solid #00d4c8;
    outline-offset: 2px;
  }

  /* Compact on very small screens */
  @media (max-width: 400px) {
    .time-total {
      display: none;
    }

    .volume-btn {
      display: none;
    }
  }
</style>
