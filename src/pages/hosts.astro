---
import BaseLayout from '../layouts/BaseLayout.astro';

const hosts = [
  {
    initials: 'JC',
    name: 'John Cleary',
    role: 'Director, Software Development at 360Insights',
    bio: 'John is a software engineering leader and tech community enthusiast based in the North West. When he\'s not building distributed systems, he\'s exploring the startup and innovation scene across Manchester and beyond.',
    linkedin: '#',
  },
  {
    initials: 'ZG',
    name: 'Zack Georgiou',
    role: 'Co-Founder, Chroma Recruitment',
    bio: 'Zack is a recruitment specialist and entrepreneur with deep roots in the North West tech and business ecosystem. He founded Chroma Recruitment to connect exceptional talent with the region\'s most exciting companies.',
    linkedin: '#',
  },
];
---

<BaseLayout
  title="Meet the Hosts — NorthWestify"
  description="Get to know John Cleary and Zack Georgiou, the hosts behind NorthWestify — the podcast exploring business, tech, and innovation in the North West."
>
  <main class="hosts-page">

    <!-- Hero -->
    <section class="page-hero">
      <div class="container">
        <h1 class="hero-heading">Meet the Hosts</h1>
        <p class="hero-intro">
          Two North West voices, one podcast — exploring what makes this region's
          tech and business scene tick.
        </p>
      </div>
    </section>

    <!-- Host cards -->
    <section class="hosts-section">
      <div class="container">
        <div class="host-grid">
          {hosts.map((host) => (
            <article class="host-card">
              <div class="host-avatar" aria-hidden="true">
                <span>{host.initials}</span>
              </div>
              <div class="host-info">
                <h2 class="host-name">{host.name}</h2>
                <p class="host-role">{host.role}</p>
                <p class="host-bio">{host.bio}</p>
                <a
                  href={host.linkedin}
                  class="linkedin-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${host.name} on LinkedIn`}
                >
                  <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                  LinkedIn
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- About the show -->
    <section class="about-section">
      <div class="container">
        <div class="about-inner">
          <h2 class="about-heading">About the Show</h2>
          <div class="about-body">
            <p>
              NorthWestify is a podcast dedicated to celebrating the entrepreneurs,
              innovators, and leaders shaping the North West of England. Each episode
              brings an honest, unscripted conversation with someone who is building
              something remarkable in the region.
            </p>
            <p>
              From early-stage founders to seasoned executives, from Manchester's
              thriving tech scene to the wider ecosystem stretching across Lancashire,
              Cheshire, and beyond — NorthWestify shines a light on the stories,
              challenges, and opportunities that define doing business up North.
            </p>
            <p>
              New episodes drop regularly. Subscribe wherever you listen to podcasts
              and join the conversation.
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .hosts-page {
    padding-bottom: 5rem;
  }

  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  /* Hero */
  .page-hero {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 3.5rem;
  }

  .hero-heading {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .hero-intro {
    font-family: var(--font-body);
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    max-width: 560px;
    line-height: 1.6;
  }

  /* Host grid */
  .hosts-section {
    margin-bottom: 4rem;
  }

  .host-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .host-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: border-color var(--transition-base);
  }

  .host-card:hover {
    border-color: rgba(0, 212, 200, 0.3);
  }

  /* Avatar */
  .host-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #2a2a2a;
    border: 2px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .host-avatar span {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  /* Host info */
  .host-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .host-name {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .host-role {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  .host-bio {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-top: 0.25rem;
  }

  .linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-top: 0.5rem;
    transition: color var(--transition-fast);
  }

  .linkedin-link:hover {
    color: var(--color-accent);
  }

  /* About section */
  .about-section {
    padding-top: 1rem;
  }

  .about-inner {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    max-width: 800px;
  }

  .about-heading {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about-body p {
    font-family: var(--font-body);
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  /* Mobile */
  @media (max-width: 640px) {
    .host-grid {
      grid-template-columns: 1fr;
    }

    .about-inner {
      padding: 1.5rem;
    }
  }
</style>
