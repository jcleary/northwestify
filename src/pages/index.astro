---
import BaseLayout from '../layouts/BaseLayout.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import { getEpisodes, getShowInfo } from '../utils/rss';

const episodes = await getEpisodes();
const showInfo = await getShowInfo();

const heroArtwork = episodes.slice(0, 12);
const latestEpisode = episodes[0];
const recentEpisodes = episodes.slice(0, 6);

// Truncate show description to ~2 sentences
function truncateToSentences(text: string, n: number): string {
  const sentences = text.match(/[^.!?]+[.!?]+/g) ?? [text];
  return sentences.slice(0, n).join(' ').trim();
}
const heroSubtitle = truncateToSentences(showInfo.description, 2);

// Format a date for display
function formatDate(isoString: string): string {
  try {
    return new Intl.DateTimeFormat('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    }).format(new Date(isoString));
  } catch {
    return isoString;
  }
}
---

<BaseLayout
  title="NorthWestify — Business conversations from the North West"
  description={heroSubtitle}
  image={showInfo.imageUrl || latestEpisode?.artworkUrl}
>

  <!-- ===================== HERO ===================== -->
  <section class="hero" aria-label="Hero">
    <!-- Artwork mosaic background -->
    <div class="hero-mosaic" aria-hidden="true">
      {heroArtwork.map((ep) => (
        <div class="mosaic-cell">
          <img
            src={ep.artworkUrl}
            alt=""
            loading="eager"
            decoding="async"
            width="200"
            height="200"
          />
        </div>
      ))}
    </div>
    <!-- Dark overlay -->
    <div class="hero-overlay" aria-hidden="true"></div>

    <!-- Hero content -->
    <div class="hero-content container">
      <img
        src="https://static.libsyn.com/p/assets/a/e/5/c/ae5c5880e9ec9060/NWify_visual.jpg"
        alt="NorthWestify logo"
        class="hero-logo"
        width="120"
        height="120"
        loading="eager"
        decoding="async"
      />

      <h1 class="hero-headline">
        Real conversations.<br />Real people.<br />Real North West.
      </h1>

      {heroSubtitle && (
        <p class="hero-subtitle">{heroSubtitle}</p>
      )}

      <div class="hero-buttons">
        <a href="#" class="btn btn--outline" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
            <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 4.5a7.5 7.5 0 0 1 7.5 7.5 7.5 7.5 0 0 1-7.5 7.5A7.5 7.5 0 0 1 4.5 12 7.5 7.5 0 0 1 12 4.5zm0 1.5a6 6 0 0 0-6 6 6 6 0 0 0 6 6 6 6 0 0 0 6-6 6 6 0 0 0-6-6zm0 2.25a3.75 3.75 0 0 1 3.75 3.75 3.75 3.75 0 0 1-3.75 3.75A3.75 3.75 0 0 1 8.25 12 3.75 3.75 0 0 1 12 8.25zm0 1.5a2.25 2.25 0 0 0-2.25 2.25A2.25 2.25 0 0 0 12 14.25 2.25 2.25 0 0 0 14.25 12 2.25 2.25 0 0 0 12 9.75z"/>
          </svg>
          Listen on Apple Podcasts
        </a>
        <a href="#" class="btn btn--teal" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
            <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
          </svg>
          Listen on Spotify
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="scroll-indicator" aria-hidden="true">
      <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="28" height="28">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  </section>

  <!-- ===================== LATEST EPISODE ===================== -->
  {latestEpisode && (
    <section class="section latest-section" aria-labelledby="latest-heading">
      <div class="container">
        <h2 class="section-title" id="latest-heading">Latest Episode</h2>

        <article class="featured-card">
          <div class="featured-artwork">
            <img
              src={latestEpisode.artworkUrl}
              alt={`Episode artwork for ${latestEpisode.guestName || latestEpisode.title}`}
              width="560"
              height="560"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="featured-body">
            <div class="featured-meta">
              <span class="badge badge--season">S{latestEpisode.season} E{latestEpisode.episodeNumber}</span>
              <span class="featured-date">{formatDate(latestEpisode.pubDate)}</span>
            </div>

            {latestEpisode.guestName
              ? <h3 class="featured-guest">{latestEpisode.guestName}</h3>
              : <h3 class="featured-guest">{latestEpisode.title}</h3>
            }

            {latestEpisode.guestTitle && (
              <p class="featured-job">{latestEpisode.guestTitle}</p>
            )}

            <p class="featured-description">{latestEpisode.description}</p>

            <div class="featured-duration">
              <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14" aria-hidden="true">
                <path d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1zm0 1.5a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11zM7.25 4v4.31l2.97 1.72-.75 1.3L6 9.5V4h1.25z"/>
              </svg>
              {latestEpisode.duration}
            </div>

            <audio
              controls
              class="featured-audio"
              preload="none"
              aria-label={`Audio player for episode: ${latestEpisode.guestName || latestEpisode.title}`}
            >
              <source src={latestEpisode.audioUrl} type="audio/mpeg" />
              Your browser does not support the audio element.
            </audio>

            <a href={`/episodes/${latestEpisode.slug}`} class="featured-link">
              Full Episode <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </article>
      </div>
    </section>
  )}

  <!-- ===================== ABOUT ===================== -->
  <section class="section about-section" aria-labelledby="about-heading">
    <div class="container">
      <h2 class="section-title" id="about-heading">About the Show</h2>
      <div class="about-inner">
        <p class="about-description">
          NorthWestify is a podcast celebrating the business and technology community across the North West of England. Every episode, hosts John Cleary and Zack Georgiou sit down with founders, engineers, and leaders to share their stories and insights.
        </p>

        <div class="hosts">
          <div class="host">
            <div class="host-avatar" aria-hidden="true"></div>
            <span class="host-name">John Cleary</span>
          </div>
          <div class="host">
            <div class="host-avatar" aria-hidden="true"></div>
            <span class="host-name">Zack Georgiou</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== RECENT EPISODES ===================== -->
  <section class="section episodes-section" aria-labelledby="recent-heading">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title" id="recent-heading">Recent Episodes</h2>
        <a href="/episodes" class="view-all-link">View All Episodes <span aria-hidden="true">&rarr;</span></a>
      </div>

      <div class="episodes-grid">
        {recentEpisodes.map((ep) => (
          <EpisodeCard episode={ep} />
        ))}
      </div>

      <div class="view-all-mobile">
        <a href="/episodes" class="btn btn--outline">View All Episodes &rarr;</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ============================================================
     HERO
  ============================================================ */
  .hero {
    position: relative;
    min-height: 100svh;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    /* Offset for the sticky header (64px) */
    margin-top: -64px;
    padding-top: 64px;
  }

  /* Mosaic grid */
  .hero-mosaic {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 1fr;
    gap: 0;
    pointer-events: none;
  }

  .mosaic-cell {
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }

  .mosaic-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.6);
    transition: transform 8s ease;
  }

  /* Dark overlay */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(13, 13, 13, 0.72);
    z-index: 1;
  }

  /* Content layer */
  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
    padding-top: 2rem;
    padding-bottom: 5rem;
    width: 100%;
  }

  .hero-logo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid rgba(0, 212, 200, 0.4);
    box-shadow: 0 0 0 6px rgba(0, 212, 200, 0.08);
    flex-shrink: 0;
  }

  .hero-headline {
    font-family: 'Syne', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(2.5rem, 6vw, 5rem);
    line-height: 1.1;
    color: #ffffff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.6);
    max-width: 820px;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: #aaaaaa;
    max-width: 640px;
    line-height: 1.65;
  }

  /* CTA buttons */
  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.75rem 1.625rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background 200ms ease, color 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
    white-space: nowrap;
    cursor: pointer;
    border: 2px solid transparent;
  }

  .btn--outline {
    border-color: rgba(255, 255, 255, 0.7);
    color: #ffffff;
    background: transparent;
  }

  .btn--outline:hover {
    background: #00d4c8;
    border-color: #00d4c8;
    color: #0d0d0d;
    opacity: 1;
    box-shadow: 0 0 20px rgba(0, 212, 200, 0.35);
  }

  .btn--teal {
    background: #00d4c8;
    color: #0d0d0d;
    border-color: #00d4c8;
  }

  .btn--teal:hover {
    background: #00ece4;
    border-color: #00ece4;
    opacity: 1;
    box-shadow: 0 0 24px rgba(0, 212, 200, 0.4);
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: rgba(255, 255, 255, 0.45);
    animation: bounce 2.2s ease-in-out infinite;
  }

  .chevron {
    display: block;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%       { transform: translateX(-50%) translateY(8px); }
  }

  /* Mobile mosaic: fewer columns */
  @media (max-width: 640px) {
    .hero-mosaic {
      grid-template-columns: repeat(2, 1fr);
    }
    .hero-headline {
      font-size: clamp(2rem, 10vw, 3.5rem);
    }
    .hero-buttons {
      flex-direction: column;
      align-items: stretch;
    }
    .btn {
      justify-content: center;
    }
  }

  @media (min-width: 641px) and (max-width: 1024px) {
    .hero-mosaic {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ============================================================
     SHARED SECTION STYLES
  ============================================================ */
  .section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .section-title {
    font-family: 'Syne', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    color: #ffffff;
    margin-bottom: 2.5rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .section-header .section-title {
    margin-bottom: 0;
  }

  .view-all-link {
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.9375rem;
    color: #00d4c8;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 150ms ease;
    flex-shrink: 0;
  }

  .view-all-link:hover {
    opacity: 0.75;
  }

  /* ============================================================
     FEATURED CARD (Latest Episode)
  ============================================================ */
  .latest-section {
    background: #0d0d0d;
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
    background: #1a1a1a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    overflow: hidden;
  }

  .featured-artwork {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #111;
  }

  .featured-artwork img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  .featured-card:hover .featured-artwork img {
    transform: scale(1.03);
  }

  .featured-body {
    padding: 2.5rem 2.5rem 2.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border-radius: 4px;
    padding: 0.25em 0.6em;
    line-height: 1.4;
  }

  .badge--season {
    background: rgba(0, 212, 200, 0.15);
    color: #00d4c8;
    border: 1px solid rgba(0, 212, 200, 0.25);
  }

  .featured-date {
    font-size: 0.8125rem;
    color: #888;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .featured-guest {
    font-family: 'Syne', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    color: #ffffff;
    line-height: 1.15;
  }

  .featured-job {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1rem;
    color: #888;
    font-style: italic;
    line-height: 1.45;
  }

  .featured-description {
    font-size: 0.9375rem;
    color: #aaa;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-duration {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: #888;
    font-family: 'Inter', system-ui, sans-serif;
  }

  .featured-audio {
    width: 100%;
    margin-top: 0.25rem;
    accent-color: #00d4c8;
    border-radius: 4px;
    /* Browsers style <audio controls> natively — we just nudge the accent colour */
  }

  .featured-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.9375rem;
    color: #00d4c8;
    text-decoration: none;
    margin-top: 0.25rem;
    transition: opacity 150ms ease;
  }

  .featured-link:hover {
    opacity: 0.75;
  }

  @media (max-width: 860px) {
    .featured-card {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .featured-artwork {
      aspect-ratio: 16 / 9;
      max-height: 320px;
    }

    .featured-body {
      padding: 1.75rem;
    }
  }

  /* ============================================================
     ABOUT SECTION
  ============================================================ */
  .about-section {
    background: #1a1a1a;
  }

  .about-inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .about-description {
    font-size: clamp(1rem, 2vw, 1.1875rem);
    color: #cccccc;
    line-height: 1.75;
    max-width: 700px;
  }

  .hosts {
    display: flex;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .host {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .host-avatar {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    background: linear-gradient(135deg, #2a2a2a 0%, #3a3a3a 100%);
    border: 2px solid rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }

  .host-name {
    font-family: 'Syne', system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.9375rem;
    color: #ffffff;
    letter-spacing: 0.02em;
  }

  /* ============================================================
     RECENT EPISODES GRID
  ============================================================ */
  .episodes-section {
    background: #0d0d0d;
  }

  .episodes-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .view-all-mobile {
    display: none;
    margin-top: 2.5rem;
    justify-content: center;
  }

  @media (max-width: 1024px) {
    .episodes-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .episodes-grid {
      grid-template-columns: 1fr;
    }

    .view-all-link {
      display: none;
    }

    .view-all-mobile {
      display: flex;
    }
  }
</style>
