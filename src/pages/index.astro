---
import BaseLayout from '../layouts/BaseLayout.astro';
import EpisodeCard from '../components/EpisodeCard.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import { getEpisodes, getShowInfo } from '../utils/rss';

const episodes = await getEpisodes();
const showInfo = await getShowInfo();

const latestEpisode = episodes[0];
const recentEpisodes = episodes.slice(1, 7);

function formatDate(isoString: string): string {
  try {
    return new Intl.DateTimeFormat('en-GB', {
      day: 'numeric', month: 'short', year: 'numeric',
    }).format(new Date(isoString));
  } catch {
    return isoString;
  }
}

const topics = [
  { label: 'Founders', style: 'outline' },
  { label: 'AI in production', style: 'orange' },
  { label: 'Ops at scale', style: 'outline' },
  { label: 'Hiring', style: 'navy' },
  { label: 'Bootstrapped', style: 'outline' },
  { label: 'Hard tech', style: 'butter' },
  { label: 'Design systems', style: 'outline' },
  { label: 'CTO life', style: 'outline' },
];
---

<BaseLayout
  title="NorthWestify — Business conversations from the North West"
  description="Real talk with the founders, CTOs and operators shaping tech and business in the North West."
  image={showInfo.imageUrl || latestEpisode?.artworkUrl}
>

  <!-- ===================== HERO ===================== -->
  <section class="hero-section" aria-label="Hero">
    <div class="container">
      <div class="hero-inner hm-dots">

        <!-- Sticker row -->
        <div class="hero-stickers" aria-hidden="true">
          <span class="sticker sticker--butter" style="transform:rotate(-2deg)">🎙 Season 5 in your ears</span>
          <span class="sticker sticker--orange" style="transform:rotate(1.5deg)">Made in Manchester</span>
          <span class="sticker sticker--navy" style="transform:rotate(-1deg)">47 episodes · 4,200 listeners</span>
        </div>

        <div class="hero-grid">
          <!-- Left -->
          <div class="hero-left">
            <h1 class="hero-headline">
              Real talk with<br />the people<br /><span class="text-orange">actually<br />doing it.</span>
            </h1>
            <p class="hero-body">
              A fortnightly chinwag with the founders, CTOs and operators shaping tech and business
              in the North West. Chatty. Thoughtful. Occasionally chaotic.
            </p>
            <div class="hero-actions">
              {latestEpisode && (
                <a href={`/episodes/${latestEpisode.slug}`} class="play-latest-btn">
                  Play the latest episode
                  <span class="play-orb" aria-hidden="true">
                    <span class="play-tri"></span>
                  </span>
                </a>
              )}
              <div class="platform-row">
                <span class="mono-label">Listen on</span>
                <div class="platform-icons">
                  <a href="https://podcasts.apple.com/ie/podcast/northwestify-podcast/id1483460602" class="platform-icon platform-apple" aria-label="Listen on Apple Podcasts" target="_blank" rel="noopener noreferrer">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
                      <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 4.5a7.5 7.5 0 0 1 7.5 7.5 7.5 7.5 0 0 1-7.5 7.5A7.5 7.5 0 0 1 4.5 12 7.5 7.5 0 0 1 12 4.5zm0 1.5a6 6 0 0 0-6 6 6 6 0 0 0 6 6 6 6 0 0 0 6-6 6 6 0 0 0-6-6zm0 2.25a3.75 3.75 0 0 1 3.75 3.75 3.75 3.75 0 0 1-3.75 3.75A3.75 3.75 0 0 1 8.25 12 3.75 3.75 0 0 1 12 8.25zm0 1.5a2.25 2.25 0 0 0-2.25 2.25A2.25 2.25 0 0 0 12 14.25 2.25 2.25 0 0 0 14.25 12 2.25 2.25 0 0 0 12 9.75z"/>
                    </svg>
                  </a>
                  <a href="https://open.spotify.com/show/2bMW8JJU1n5c08hL1oVfL4" class="platform-icon platform-spotify" aria-label="Listen on Spotify" target="_blank" rel="noopener noreferrer">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
                      <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: overlapping host circles -->
          <div class="hero-right" aria-hidden="true">
            <div class="host-circles">
              <div class="host-circle host-circle--a">
                <img
                  src={showInfo.imageUrl || 'https://static.libsyn.com/p/assets/a/e/5/c/ae5c5880e9ec9060/NWify_visual.jpg'}
                  alt="John Cleary"
                  width="220" height="220"
                  loading="eager"
                />
              </div>
              <div class="host-circle host-circle--b">
                <img
                  src="/zack-georgiou.jpg"
                  alt="Zack Georgiou"
                  width="220" height="220"
                  loading="eager"
                />
              </div>
              <span class="sticker sticker--butter host-sticker-label" style="transform:rotate(-8deg)">
                <span class="dot-indicator"></span>
                John + Zack
              </span>
              <span class="sticker sticker--default host-sticker-cta" style="transform:rotate(6deg)">Your hosts ↗</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================== TAG CHIPS ===================== -->
  <section class="tags-section" aria-label="Topics">
    <div class="container">
      <div class="tags-row">
        <span class="mono-label tags-intro">What we chat about →</span>
        {topics.map(({ label, style }) => (
          <span class={`chip chip--${style}`}>{label}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- ===================== FEATURED EPISODE ===================== -->
  {latestEpisode && (
    <section class="featured-section" aria-labelledby="featured-heading">
      <div class="container">
        <div class="section-header">
          <div>
            <div class="section-label">This week 🔥</div>
            <h2 class="section-title" id="featured-heading">Hot off the mic</h2>
          </div>
          <span class="chip chip--outline">{formatDate(latestEpisode.pubDate)}</span>
        </div>

        <div class="featured-card">
          <!-- Left: circular artwork -->
          <div class="featured-art-col">
            <div class="featured-circle">
              <img
                src={latestEpisode.artworkUrl}
                alt={`Episode artwork for ${latestEpisode.guestName || latestEpisode.title}`}
                width="360" height="360"
                loading="lazy"
                decoding="async"
              />
            </div>
            <span class="sticker sticker--butter featured-badge" style="transform:rotate(8deg)">
              NEW · S{latestEpisode.season}·E{latestEpisode.episodeNumber}
            </span>
          </div>

          <!-- Right: info + player -->
          <div class="featured-body">
            <div class="featured-chips">
              <span class="chip chip--solid">{latestEpisode.duration}</span>
              {latestEpisode.season && (
                <span class="chip chip--cream-transparent">Season {latestEpisode.season}</span>
              )}
            </div>

            <h3 class="featured-title">{latestEpisode.guestName || latestEpisode.title}</h3>

            {latestEpisode.guestTitle && (
              <div class="featured-guest-info">
                Featuring <span class="featured-guest-highlight">{latestEpisode.guestTitle}</span>
              </div>
            )}

            <p class="featured-excerpt">
              {latestEpisode.description.length > 280
                ? latestEpisode.description.slice(0, 280).trimEnd() + '…'
                : latestEpisode.description}
            </p>

            <div class="featured-player">
              <AudioPlayer audioUrl={latestEpisode.audioUrl} title={latestEpisode.guestName || latestEpisode.title} />
            </div>

            <a href={`/episodes/${latestEpisode.slug}`} class="featured-link">
              Full episode →
            </a>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ===================== THE VAULT ===================== -->
  <section class="vault-section" aria-labelledby="vault-heading">
    <div class="container">
      <div class="section-header vault-header">
        <h2 class="vault-title" id="vault-heading">The vault.</h2>
        <div class="vault-filters">
          <span class="mono-label">Filter</span>
          <span class="chip chip--solid">All</span>
          <a href="/episodes" class="chip chip--outline chip--link">All episodes →</a>
        </div>
      </div>

      <div class="vault-grid">
        {recentEpisodes.map((ep, i) => (
          <EpisodeCard episode={ep} colorIndex={i} />
        ))}
      </div>

      <div class="vault-more">
        <a href="/episodes" class="load-more-btn">View all episodes ↓</a>
      </div>
    </div>
  </section>

  <!-- ===================== PULL QUOTE ===================== -->
  <section class="quote-section" aria-label="Listener reviews">
    <div class="container">
      <div class="quote-card">
        <div class="quote-deco-a" aria-hidden="true"></div>
        <div class="quote-deco-b" aria-hidden="true"></div>
        <div class="quote-grid">
          <div class="quote-left">
            <div class="quote-stars">★ ★ ★ ★ ★ &nbsp;·&nbsp; Apple Podcasts</div>
            <blockquote class="quote-text">
              "Easily the most useful business podcast I listen to. The guests are the people I actually want to learn from, and they don't read their LinkedIn bios out loud."
            </blockquote>
            <div class="quote-attr">— listener since Season 2</div>
          </div>
          <div class="quote-stats">
            <div class="stat-card">
              <div class="stat-number">4.9 <span class="stat-star">★</span></div>
              <div class="stat-label">Across Apple Podcasts reviews</div>
            </div>
            <div class="stat-card">
              <div class="stat-number">4,200</div>
              <div class="stat-label">Listeners and counting</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== NEWSLETTER ===================== -->
  <section class="newsletter-section" aria-labelledby="newsletter-heading">
    <div class="container">
      <div class="newsletter-card">
        <span class="sticker sticker--orange newsletter-badge" style="transform:rotate(8deg)">📬 Every other Tuesday</span>
        <div class="newsletter-grid">
          <div class="newsletter-left">
            <h2 class="newsletter-title" id="newsletter-heading">Drop in your inbox?</h2>
            <p class="newsletter-body">
              A short note when a new episode lands. Pull-quote, three timestamps worth jumping to,
              one thing we wish we'd asked.
            </p>
            <div class="newsletter-proof">
              <div class="avatar-stack" aria-hidden="true">
                <span class="avatar-dot" style="background:#FF6B35"></span>
                <span class="avatar-dot" style="background:#004E89"></span>
                <span class="avatar-dot" style="background:#FFC93C"></span>
                <span class="avatar-dot" style="background:#1A1A1A"></span>
              </div>
              <span class="proof-text">4.2k on the list</span>
              <span class="proof-sep" aria-hidden="true">·</span>
              <span class="proof-text">No spam ever</span>
            </div>
          </div>
          <div class="newsletter-right">
            <form class="newsletter-form" action="#" method="post">
              <input
                type="email"
                name="email"
                placeholder="hello@yourcompany.co"
                class="newsletter-input"
                aria-label="Your email address"
              />
              <button type="submit" class="newsletter-submit">
                Yes, send me the memo
                <span class="submit-orb" aria-hidden="true">→</span>
              </button>
              <div class="form-divider" aria-hidden="true">
                <span class="divider-line"></span>
                <span class="mono-label">OR</span>
                <span class="divider-line"></span>
              </div>
              <a href="/contact" class="ask-btn">Got a question? Ask us anything ↗</a>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ============================================================
     SHARED PRIMITIVES
  ============================================================ */

  /* Dotted background pattern */
  .hm-dots {
    background-image: radial-gradient(rgba(26, 26, 26, 0.14) 1.4px, transparent 1.4px);
    background-size: 18px 18px;
  }

  /* Sticker badge */
  .sticker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 999px;
    padding: 8px 16px;
    font-family: 'Unbounded', system-ui, sans-serif;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.02em;
    box-shadow: 0 4px 0 rgba(26, 26, 26, 0.12);
    white-space: nowrap;
  }

  .sticker--butter  { background: #FFC93C; color: #1A1A1A; }
  .sticker--orange  { background: #FF6B35; color: #FFF4E8; }
  .sticker--navy    { background: #004E89; color: #FFF4E8; }
  .sticker--default { background: #FFC93C; color: #1A1A1A; }

  /* Chips */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-radius: 999px;
    padding: 7px 15px;
    font-family: 'Inter Tight', system-ui, sans-serif;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    color: inherit;
    transition: opacity 150ms ease;
  }

  .chip--outline  { background: transparent; border: 1.5px solid rgba(26, 26, 26, 0.2); color: #1A1A1A; }
  .chip--solid    { background: #1A1A1A; color: #FFF4E8; border: 1.5px solid transparent; }
  .chip--orange   { background: #FF6B35; color: #FFF4E8; border: 1.5px solid transparent; }
  .chip--navy     { background: #004E89; color: #FFF4E8; border: 1.5px solid transparent; }
  .chip--butter   { background: #FFC93C; color: #1A1A1A; border: 1.5px solid transparent; }
  .chip--link:hover { opacity: 0.7; }
  .chip--cream-transparent {
    background: rgba(255, 251, 245, 0.18);
    color: #FFF4E8;
    border: 1.5px solid rgba(255, 251, 245, 0.2);
  }

  /* Mono label */
  .mono-label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    color: rgba(26, 26, 26, 0.5);
  }

  /* Orange text */
  .text-orange { color: #FF6B35; }

  /* Section shared */
  .section-label {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    color: #FF6B35;
    margin-bottom: 6px;
  }

  .section-title {
    font-family: 'Unbounded', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(2rem, 4vw, 3.25rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: #1A1A1A;
    margin: 0;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }

  /* ============================================================
     HERO
  ============================================================ */
  .hero-section {
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(3rem, 6vw, 5rem);
  }

  .hero-inner {
    border-radius: 36px;
    background-color: #FFE8D6;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3.5rem);
    position: relative;
  }

  .hero-stickers {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero-headline {
    font-family: 'Unbounded', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(3rem, 7vw, 6.5rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: #1A1A1A;
    margin: 0 0 1.75rem;
  }

  .hero-body {
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    line-height: 1.55;
    color: #3a3a3a;
    font-weight: 500;
    max-width: 540px;
    margin: 0 0 2.25rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  /* "Play the latest episode" button */
  .play-latest-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: #1A1A1A;
    color: #FFF4E8;
    border: none;
    padding: 12px 12px 12px 22px;
    border-radius: 999px;
    cursor: pointer;
    font-size: 15px;
    font-weight: 700;
    font-family: 'Inter Tight', system-ui, sans-serif;
    text-decoration: none;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }

  .play-latest-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(26, 26, 26, 0.2);
    opacity: 1;
  }

  .play-orb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #FF6B35;
    color: #1A1A1A;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .play-tri {
    display: block;
    width: 0;
    height: 0;
    border-left: 10px solid currentColor;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    margin-left: 3px;
  }

  /* Platform row */
  .platform-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .platform-icons {
    display: flex;
    gap: 8px;
  }

  .platform-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    transition: transform 150ms ease;
  }

  .platform-icon:hover {
    transform: scale(1.1);
    opacity: 1;
  }

  .platform-apple   { background: #A855F7; }
  .platform-spotify { background: #1DB954; }

  /* Host circles */
  .hero-right {
    display: flex;
    justify-content: center;
  }

  .host-circles {
    position: relative;
    width: 340px;
    height: 340px;
    flex-shrink: 0;
  }

  .host-circle {
    position: absolute;
    border-radius: 50%;
    overflow: hidden;
    border: 6px solid #FFF4E8;
  }

  .host-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .host-circle--a {
    top: 20px;
    left: 0;
    width: 200px;
    height: 200px;
    background: #FF6B35;
    box-shadow: 0 12px 30px rgba(255, 107, 53, 0.3);
  }

  .host-circle--b {
    bottom: 0;
    right: 0;
    width: 200px;
    height: 200px;
    background: #004E89;
    box-shadow: 0 12px 30px rgba(0, 78, 137, 0.3);
  }

  .host-sticker-label {
    position: absolute;
    bottom: -8px;
    left: 20px;
  }

  .host-sticker-cta {
    position: absolute;
    top: -10px;
    right: 30px;
  }

  .dot-indicator {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #FF6B35;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-right {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-headline {
      font-size: clamp(2.5rem, 10vw, 4rem);
    }
    .hero-actions {
      flex-direction: column;
      align-items: flex-start;
    }
    .hero-stickers {
      gap: 8px;
    }
    .sticker {
      font-size: 11px;
      padding: 6px 12px;
    }
  }

  /* ============================================================
     TAGS SECTION
  ============================================================ */
  .tags-section {
    padding: clamp(2rem, 4vw, 3rem) 0;
  }

  .tags-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tags-intro {
    margin-right: 4px;
    flex-shrink: 0;
  }

  /* ============================================================
     FEATURED EPISODE
  ============================================================ */
  .featured-section {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .featured-card {
    background: #FF6B35;
    border-radius: 28px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 400px 1fr;
    align-items: center;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .featured-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 20px 48px rgba(255, 107, 53, 0.3);
  }

  /* Artwork column */
  .featured-art-col {
    padding: 2.5rem 1.5rem 2.5rem 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .featured-circle {
    width: 300px;
    height: 300px;
    border-radius: 50%;
    overflow: hidden;
    background: #FFE8D6;
    border: 8px solid #FFF4E8;
    box-shadow: 0 16px 40px rgba(26, 26, 26, 0.2);
  }

  .featured-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .featured-badge {
    position: absolute;
    top: 28px;
    right: 8px;
  }

  /* Body column */
  .featured-body {
    padding: clamp(1.75rem, 3vw, 3rem) clamp(1.75rem, 3.5vw, 3.5rem) clamp(1.75rem, 3vw, 3rem) 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: #FFF4E8;
  }

  .featured-chips {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .featured-title {
    font-family: 'Unbounded', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(1.75rem, 3.5vw, 3rem);
    letter-spacing: -0.04em;
    line-height: 1.0;
    color: #FFF4E8;
    margin: 0;
  }

  .featured-guest-info {
    font-size: 1rem;
    font-weight: 600;
    color: rgba(255, 244, 232, 0.85);
