---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EpisodeCard from '../../components/EpisodeCard.astro';
import { getEpisodes } from '../../utils/rss';

const episodes = await getEpisodes();

// Group episodes by season, descending season order
const seasonMap = new Map<number, typeof episodes>();
for (const ep of episodes) {
  const s = ep.season || 0;
  if (!seasonMap.has(s)) seasonMap.set(s, []);
  seasonMap.get(s)!.push(ep);
}

// Seasons sorted descending (most recent first)
const seasons = [...seasonMap.keys()].sort((a, b) => b - a);

const totalEpisodes = episodes.length;
---

<BaseLayout
  title="All Episodes — NorthWestify"
  description={`Browse all ${totalEpisodes} episodes of NorthWestify. Conversations with founders, engineers, and leaders from across the North West of England.`}
>

  <!-- ===================== PAGE HERO ===================== -->
  <section class="page-hero" aria-label="Page header">
    <div class="container">
      <h1 class="page-title">Episodes</h1>
      <p class="page-subtitle">
        {totalEpisodes} conversations with founders, engineers, and leaders from across the North West.
      </p>
    </div>
  </section>

  <!-- ===================== FILTER CHIPS ===================== -->
  <div class="filter-bar" role="group" aria-label="Filter episodes by season">
    <div class="container filter-inner">
      <button
        class="filter-chip filter-chip--active"
        data-filter="all"
        aria-pressed="true"
        type="button"
      >
        All
      </button>
      {seasons.map((s) => (
        <button
          class="filter-chip"
          data-filter={String(s)}
          aria-pressed="false"
          type="button"
        >
          Season {s}
        </button>
      ))}
    </div>
  </div>

  <!-- ===================== EPISODE GROUPS ===================== -->
  <main class="episodes-main" id="episodes-list">
    <div class="container">
      {seasons.map((s) => {
        const group = seasonMap.get(s)!;
        return (
          <section
            class="season-group"
            data-season={String(s)}
            aria-labelledby={`season-${s}-heading`}
          >
            <div class="season-header">
              <h2 class="season-heading" id={`season-${s}-heading`}>
                Season {s}
              </h2>
              <span class="season-count">{group.length} episode{group.length !== 1 ? 's' : ''}</span>
            </div>

            <div class="episodes-grid">
              {group.map((ep, i) => (
                <div class="grid-item" data-season={String(s)}>
                  <EpisodeCard episode={ep} colorIndex={i} />
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </main>

</BaseLayout>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const groups = document.querySelectorAll<HTMLElement>('.season-group');

  function applyFilter(filter: string) {
    chips.forEach((chip) => {
      const isActive = chip.dataset.filter === filter;
      chip.classList.toggle('filter-chip--active', isActive);
      chip.setAttribute('aria-pressed', String(isActive));
    });

    if (filter === 'all') {
      groups.forEach((g) => {
        g.style.display = '';
      });
    } else {
      groups.forEach((g) => {
        const visible = g.dataset.season === filter;
        g.style.display = visible ? '' : 'none';
      });
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      applyFilter(chip.dataset.filter ?? 'all');
    });
  });
</script>

<style>
  /* ============================================================
     PAGE HERO
  ============================================================ */
  .page-hero {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .page-title {
    font-family: 'Unbounded', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(2.5rem, 7vw, 5rem);
    color: #1A1A1A;
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
  }

  .page-subtitle {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: rgba(26, 26, 26, 0.6);
    max-width: 560px;
    line-height: 1.65;
    font-family: 'Inter Tight', system-ui, sans-serif;
  }

  /* ============================================================
     FILTER BAR
  ============================================================ */
  .filter-bar {
    position: sticky;
    top: 72px;
    z-index: 50;
    background: rgba(255, 244, 232, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(26, 26, 26, 0.08);
    padding-block: 0.75rem;
  }

  .filter-inner {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .filter-chip {
    font-family: 'Inter Tight', system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.8125rem;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1.5px solid rgba(26, 26, 26, 0.15);
    background: transparent;
    color: rgba(26, 26, 26, 0.65);
    cursor: pointer;
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
    white-space: nowrap;
  }

  .filter-chip:hover {
    border-color: #FF6B35;
    color: #FF6B35;
    background: rgba(255, 107, 53, 0.06);
  }

  .filter-chip--active {
    background: #FF6B35;
    border-color: #FF6B35;
    color: #FFF4E8;
  }

  .filter-chip--active:hover {
    background: #FF8856;
    border-color: #FF8856;
    color: #FFF4E8;
  }

  /* ============================================================
     EPISODES MAIN CONTENT
  ============================================================ */
  .episodes-main {
    padding-block: clamp(2.5rem, 5vw, 4rem);
    min-height: 60vh;
  }

  /* ============================================================
     SEASON GROUP
  ============================================================ */
  .season-group {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .season-group:last-child {
    margin-bottom: 0;
  }

  .season-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(26, 26, 26, 0.08);
  }

  .season-heading {
    font-family: 'Unbounded', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    color: #1A1A1A;
    line-height: 1.0;
    letter-spacing: -0.03em;
  }

  .season-count {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(26, 26, 26, 0.45);
    font-weight: 700;
    flex-shrink: 0;
  }

  /* ============================================================
     EPISODE GRID
  ============================================================ */
  .episodes-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  .grid-item {
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 700px) {
    .episodes-grid {
      grid-template-columns: 1fr;
    }
    .filter-chip {
      font-size: 0.75rem;
    }
  }
</style>
